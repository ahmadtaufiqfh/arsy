local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local enabled = false
local connections = {}

-- ===== GUI BUTTON =====
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0,28,0,28)
btn.Position = UDim2.new(1,-50,0,15)
btn.Text = ""
btn.BackgroundTransparency = 0.2
btn.BackgroundColor3 = Color3.fromRGB(255,80,80)
btn.BorderSizePixel = 0
btn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1,0)
corner.Parent = btn

-- ===== NAME CHECK =====
local function containsPlayerName(text)
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.find(text, plr.Name) or string.find(text, plr.DisplayName) then
            return true
        end
    end
    return false
end

-- ===== BLUR FUNCTION =====
local function blur(obj)
    if not enabled then return end

    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        if obj.Text and obj.Text ~= "" then
            if containsPlayerName(obj.Text) then
                obj.Text = string.gsub(obj.Text, "%S+", function(word)
                    if containsPlayerName(word) then
                        return string.rep("█", #word)
                    end
                    return word
                end)
            end
        end
    end
end

-- ===== SCAN CORE GUI =====
local function scanCoreGui()
    for _, obj in ipairs(CoreGui:GetDescendants()) do
        blur(obj)
    end
end

local function enable()
    scanCoreGui()

    local conn = CoreGui.DescendantAdded:Connect(function(obj)
        task.wait()
        blur(obj)
    end)

    table.insert(connections, conn)
end

local function disable()
    for _, c in ipairs(connections) do
        c:Disconnect()
    end
    connections = {}
end

-- ===== TOGGLE =====
btn.MouseButton1Click:Connect(function()
    enabled = not enabled

    btn.BackgroundColor3 = enabled
        and Color3.fromRGB(80,255,80)
        or Color3.fromRGB(255,80,80)

    if enabled then
        enable()
    else
        disable()
    end
end)
